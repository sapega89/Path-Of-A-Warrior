key FIRE           # Yes -> save -> prologue (ag.l(100, 0), bV = 10)
wait 3
wait 60
key LSOFT          # Skip on a picture page = next page
wait 3
wait 60
key LSOFT
wait 3
wait 10
key FIRE           # whole text at once
wait 2
wait 25
wait 40
key LSOFT          # Skip on a dialogue page = end of the prologue
wait 4
key FIRE
