env POW_ALWAYS_ONLINE=1
env POW_SERVER_ONLY_SAVE=1
env POW_LIVE_SERVER=ws://127.0.0.1:9/live
save zero
# "server only": a hero without an account cannot skip the registration offer.
# BACK on the empty UserID closes it and the Game Menu opens it again at once.
wait 25
key FIRE           # sound: Yes
wait 2
key FIRE           # title -> Main Menu
wait 2
key FIRE           # Continue -> Game Menu -> the registration offer
wait 4
shot registration_offer
key BACK           # no skip
wait 4
shot registration_again
