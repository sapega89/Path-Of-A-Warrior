# PORT-EXTRA Order window (pow_mp/mp_canvas_order.py): the scripted player RIVAL creates the
# order WOLF, TEST joins it from the main menu's Order picture, invites RIVAL to a 2-on-2 duel on
# its side, comes back to the window after the battle and leaves the order.
# States: 30 the order, 31 a member, 32 the order name, 33 leave? (Yes / No).
include _login.keys
bot_order WOLF
key LEFT          # Duel -> Order (the last picture)
wait 3
shot main_order
key FIRE          # 1792 -> 1793
until 30
wait 3
shot no_order
key RIGHT         # Join Order
wait 2
shot join_menu
key FIRE
until 32
wait 3
key RIGHT 22      # W
key FIRE
key LEFT 8        # O
key FIRE
key LEFT 3        # L
key FIRE
key LEFT 6        # F
key FIRE
key RIGHT 21      # OK
wait 2
shot order_name
key FIRE          # 1796 -> 1797, 1792 -> 1793
until 30
wait 3
shot order_list
wait 2
shot member_cursor  # RIVAL, the leader, first
key FIRE
until 31
wait 3
shot member_menu
key RIGHT         # 2-on-2 Together
wait 2
shot member_2v2
key FIRE          # 768 mode 3 -> 769
until 92
shot room
wait 30
shot quotes
until 94,103,105
key RIGHT         # Attack
wait 9
key FIRE          # stop the timing bar
until 94,103,105
goto_if 103,105 end
