until 30
wait 5
shot back_to_order
key UP            # Leave Order (the last item)
wait 2
key FIRE
until 33
wait 3
shot leave_confirm
key FIRE          # Yes: 1798 -> 1799, 1792 -> 1793
until 30
wait 5
shot after_leave
