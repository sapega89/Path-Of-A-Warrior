# Solo Mission (me + a CPU ally against waves of monsters, a CPU fighter last), played to the result.
# States (06 §1.2): 91 stage intro, 92 quotes, 94 choose action, 96 choose target, 97 timing bar,
# 103 end (also between stages), 104 stage complete, 105 result.
include _enter.keys
watch 104 stage_complete 5
key RIGHT         # Mission
wait 3
key FIRE
wait 5
key FIRE          # Solo Mission
until 91
wait 10
shot stage_intro
until 92
wait 30
shot quotes
until 94,105 3000
goto_if 105 end
key RIGHT         # Attack
wait 2
key_if 96 FIRE    # two foes alive: take the first
wait 7
key FIRE          # stop the timing bar
until 99
wait 40
shot playback
until 94,105 3000
goto_if 105 end
key RIGHT         # Attack
wait 2
key_if 96 FIRE    # two foes alive: take the first
wait 7
key FIRE          # stop the timing bar
until 94,105 3000
goto_if 105 end
