# (always online): the single player's Gamevil Live account logs in to the Multiplayer
# game too: no Login screen, the title goes straight to the login (278, 262) and the Main Menu.
sp_account ANDREY 1234
wait 35
key FIRE          # sound: Yes
wait 3
shot title
key FIRE          # title: logs in with ANDREY / 1234 at once
wait 40           # 278/279, reconnect, 262/263
shot welcome
key FIRE          # Welcome OK
wait 20           # Main Menu, on Duel
shot main_menu
key LSOFT         # no LOGIN soft key: stays on the Main Menu
wait 5
shot main_menu_no_login
