wait 10
shot map_enter           # banner "Stage 1"
wait 45
shot room_clear          # no enemies yet: the room counts as cleared at once
wait 40
shot exits_open          # blinking arrow = exit of the room
key LEFT                 # tap = start walking
wait 12
shot walk_left_wall      # stops at the edge of the room
key RIGHT
key RIGHT                # quick double tap = run
wait 4
shot run_right
key DOWN                 # walk down to the exit
wait 25
shot walk_to_exit
wait 6
shot scroll_next_room
wait 20
shot next_room
wait 40
key RSOFT                # PAUSE -> pause menu
wait 3
shot pause_menu
key DOWN
wait 2
shot pause_cursor
key FIRE
wait 3
shot pause_sub
