wait 3
shot exit_popup
key LEFT                 # Yes
wait 2
key FIRE
wait 5
shot back_game_menu
key FIRE                 # Continue: the save was made on the map -> back into the mission
wait 8
shot continue_map
wait 40
shot continue_map_later
key DOWN                 # walk down into the last room
wait 30
shot last_room
wait 60
shot last_room_closed    # the mission's general waits here (combat): exits stay closed
