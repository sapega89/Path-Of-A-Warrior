# PORT-EXTRA Chat window (pow_mp/mp_canvas_chat.py): RIVAL writes in the lobby and to TEST in
# private; TEST opens the Chat picture (the badge counts the private message), answers RIVAL on
# the keyboard grid and the PC keyboard, RIVAL answers back; then the Lobby and the Order tab.
# States: 40 the tabs, 41 a private conversation, 42 the keyboard.
include _login.keys
bot_chat 0 Anyone up for a duel?
bot_chat 2 TEST Hi TEST, fancy a fight at the castle?
wait 3
key LEFT          # Duel -> Chat (the last picture)
wait 3
shot main_chat
key FIRE          # 1813 -> 1814: the Private tab (a message waits there)
until 40
wait 3
shot private_list
key DOWN          # RIVAL
wait 2
key FIRE          # 1808 -> 1809
until 41
wait 3
shot talk
key FIRE          # the keyboard
until 42
wait 2
key RIGHT 7       # H
key FIRE
key DOWN 2        # h
key RIGHT         # i
key FIRE
wait 2
shot grid_typing
type ! Ready when you are.
wait 3
shot write
key LSOFT         # Send: 1810 -> 1811 and 1812
until 41
wait 10           # RIVAL answers
shot talk_reply
key RSOFT         # back to the list
until 40
wait 3
key RIGHT         # Lobby
wait 6
shot lobby
key FIRE
until 42
type Hello everyone, I am new here and ready to fight!
wait 2
shot lobby_write
key LSOFT
until 40
wait 6
shot lobby_after
key RIGHT         # Order: not in an order
wait 6
shot no_order
