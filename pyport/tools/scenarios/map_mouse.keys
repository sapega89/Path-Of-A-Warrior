key BACK           # BACK does nothing in the briefing
wait 2
key LSOFT          # SKIP -> ag.y() (the map: next phase)
wait 100
shot mouse_map
click 30 120             # left of the hero = LEFT (start walking)
wait 10
shot mouse_walk_left
click 30 120             # same direction again = stop
wait 3
click 120 230            # below the hero = DOWN
wait 8
shot mouse_walk_down
click 225 312            # soft key PAUSE
wait 3
shot mouse_pause
click 120 116            # row "Options"
wait 4
shot mouse_options
click 225 312            # BACK
wait 3
click 120 86             # row "Resume"
wait 4
shot mouse_resume
