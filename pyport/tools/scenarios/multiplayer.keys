env POW_ALWAYS_ONLINE=1
save zero
# Live > Multiplayer (PORT-EXTRA, main.py): the Multiplayer screens run in the same
# window and process while the single player waits in memory; their Exit comes back to the
# Live menu. Registered on this device already (account), logged in by Continue.
account TESTUSER 1234
wait 25
key FIRE           # sound: Yes
wait 2
key FIRE           # title -> Main Menu
wait 2
key FIRE           # Continue -> Game Menu (the background login)
wait 6
key DOWN
wait 6
key DOWN           # Mission -> Blacksmith -> Live
wait 6
key FIRE           # opens at once (no question)
wait 6
key FIRE           # the welcome popup
wait 6
shot live_menu_multiplayer
key DOWN
wait 1
key DOWN
wait 1
key DOWN           # Trade -> Warehouse -> Safe -> Multiplayer
wait 2
shot multiplayer_selected
multiplayer 40 mp_title
key FIRE           # the Multiplayer screens; their Exit -> back here
wait 4
shot live_menu_back
