env POW_ALWAYS_ONLINE=1
save zero
# Gamevil Live > Multiplayer (pow/game/online_session.py): the Multiplayer screens
# are a state of the same canvas and loop; BACK in their main menu comes back to the Gamevil
# Live menu. Registered on this device already (account), logged in by Continue.
account TESTUSER 1234
wait 25
key FIRE           # sound: Yes
wait 2
key FIRE           # title -> Main Menu
wait 2
key FIRE           # Continue -> Game Menu (the background login)
wait 6
key DOWN
wait 6
key DOWN           # Mission -> Blacksmith -> Gamevil Live
wait 6
key FIRE           # opens at once (no question)
wait 6
key FIRE           # the welcome popup
wait 6
shot live_menu_multiplayer
key DOWN
wait 1
key DOWN
wait 1
key DOWN           # Trade -> Warehouse -> Safe -> Multiplayer
wait 2
shot multiplayer_selected
key FIRE           # the Multiplayer screens: no logo or sound question, its title
wait 10
shot mp_title
key FIRE           # press any key -> the login (the single player's account)
wait 30
shot mp_welcome
key FIRE           # OK -> its main menu
wait 3
shot mp_main_menu
key BACK           # its Exit: no popup, no outro
wait 4
shot live_menu_back
