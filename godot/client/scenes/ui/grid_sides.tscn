[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/grid_sides.gd" id="1"]

[sub_resource type="ButtonGroup" id="Sides"]
resource_local_to_scene = true

[node name="Sides" type="HBoxContainer"]
alignment = 1
script = ExtResource("1")

[node name="Backpack" type="Button" parent="."]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
toggle_mode = true
button_pressed = true
button_group = SubResource("Sides")
text = "live.backpack"

[node name="Warehouse" type="Button" parent="."]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
toggle_mode = true
button_group = SubResource("Sides")
text = "live.warehouse"

[connection signal="pressed" from="Backpack" to="." method="_on_backpack"]
[connection signal="pressed" from="Warehouse" to="." method="_on_warehouse"]
