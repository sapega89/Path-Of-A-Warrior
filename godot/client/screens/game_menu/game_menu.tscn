[ext_resource type="Script" path="res://scripts/ui/heading.gd" id="3"]

[node name="GameMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 1
grow_vertical = 1

[node name="Column" type="VBoxContainer" parent="Center"]
unique_name_in_owner = true
theme = ExtResource("2")
layout_mode = 2
custom_minimum_size = Vector2(460, 0)
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Center/Column"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "menu.game"
horizontal_alignment = 1
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 44
script = ExtResource("3")

[node name="Scroll" type="ScrollContainer" parent="Center/Column"]
layout_mode = 2
custom_minimum_size = Vector2(460, 600)
follow_focus = true
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Center/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
