[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://screens/endings/endings_screen.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/heading.gd" id="2"]

[node name="EndingsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 1
grow_vertical = 1

[node name="Column" type="VBoxContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(560, 0)
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Center/Column"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "endings.title"
horizontal_alignment = 1
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 40
script = ExtResource("2")

[node name="List" type="VBoxContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Turn" type="HBoxContainer" parent="Center/Column"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 24

[node name="Prev" type="Button" parent="Center/Column/Turn"]
layout_mode = 2
focus_mode = 0
text = "◄"

[node name="Page" type="Label" parent="Center/Column/Turn"]
unique_name_in_owner = true
layout_mode = 2
auto_translate_mode = 2

[node name="Next" type="Button" parent="Center/Column/Turn"]
layout_mode = 2
focus_mode = 0
text = "►"

[node name="Info" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
