horizontal_alignment = 1
autowrap_mode = 3

[node name="Back" type="Button" parent="Center/Column"]
layout_mode = 2
text = "common.back"

[connection signal="pressed" from="Center/Column/Turn/Prev" to="." method="prev_page"]

[connection signal="pressed" from="Center/Column/Turn/Next" to="." method="next_page"]

[connection signal="pressed" from="Center/Column/Back" to="." method="go_back"]
