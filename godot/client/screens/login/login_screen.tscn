[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://screens/login/login_screen.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/heading.gd" id="2"]

[node name="LoginScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 1
grow_vertical = 1

[node name="Column" type="VBoxContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(520, 0)
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Center/Column"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "login.title"
horizontal_alignment = 1
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 40
script = ExtResource("2")

[node name="Hint" type="Label" parent="Center/Column"]
layout_mode = 2
text = "register.hint"
horizontal_alignment = 1
autowrap_mode = 3

[node name="UserId" type="LineEdit" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "register.user_id"
alignment = 1
max_length = 12
keep_editing_on_text_submit = true

[node name="Password" type="LineEdit" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "register.password"
alignment = 1
max_length = 12
keep_editing_on_text_submit = true
secret = true

[node name="Login" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "login.ok"

[node name="Register" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "login.new"

[node name="Info" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 60)
auto_translate_mode = 2
horizontal_alignment = 1
autowrap_mode = 3

[connection signal="text_changed" from="Center/Column/UserId" to="." method="_on_user_id_changed"]

[connection signal="text_submitted" from="Center/Column/UserId" to="." method="_on_user_id_submitted"]

[connection signal="text_changed" from="Center/Column/Password" to="." method="_on_password_changed"]

[connection signal="text_submitted" from="Center/Column/Password" to="." method="_on_password_submitted"]

[connection signal="pressed" from="Center/Column/Login" to="." method="submit"]

[connection signal="pressed" from="Center/Column/Register" to="." method="register"]
