[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://screens/online_character/online_character_screen.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/heading.gd" id="2"]

[node name="OnlineCharacterScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 1
grow_vertical = 1

[node name="Column" type="VBoxContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(900, 0)
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Center/Column"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "online.character"
horizontal_alignment = 1
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 44
script = ExtResource("2")

[node name="Row" type="HBoxContainer" parent="Center/Column"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Menu" type="VBoxContainer" parent="Center/Column/Row"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(440, 0)
theme_override_constants/separation = 8

[node name="Records" type="Button" parent="Center/Column/Row/Menu"]
layout_mode = 2
text = "online.records"

[node name="Attributes" type="Button" parent="Center/Column/Row/Menu"]
layout_mode = 2
text = "online.attributes"

[node name="Skills" type="Button" parent="Center/Column/Row/Menu"]
layout_mode = 2
text = "online.skills"

[node name="Purse" type="Button" parent="Center/Column/Row/Menu"]
layout_mode = 2
text = "online.purse"

[node name="Quote" type="Button" parent="Center/Column/Row/Menu"]
layout_mode = 2
text = "online.quote"

[node name="Name" type="Button" parent="Center/Column/Row/Menu"]
layout_mode = 2
text = "online.name"

[node name="Info" type="Label" parent="Center/Column/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
auto_translate_mode = 2
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Back" type="Button" parent="Center/Column"]
layout_mode = 2
text = "common.back"

[connection signal="pressed" from="Center/Column/Row/Menu/Records" to="." method="open" binds= ["records"]]

[connection signal="pressed" from="Center/Column/Row/Menu/Attributes" to="." method="open" binds= ["attributes"]]

[connection signal="pressed" from="Center/Column/Row/Menu/Skills" to="." method="open" binds= ["online_skills"]]

[connection signal="pressed" from="Center/Column/Row/Menu/Purse" to="." method="open" binds= ["purse"]]

[connection signal="pressed" from="Center/Column/Row/Menu/Quote" to="." method="open" binds= ["online_text:quote"]]

[connection signal="pressed" from="Center/Column/Row/Menu/Name" to="." method="open" binds= ["online_text:name"]]

[connection signal="pressed" from="Center/Column/Back" to="." method="go_back"]
