; Mercenary's Path — Godot 4 client.
; See godot/README.md and docs/GODOT_PLAN.md.

config_version=5

[application]

config/name="Mercenary's Path"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

I18n="*res://scripts/core/i18n.gd"
Settings="*res://scripts/core/settings.gd"
InputSetup="*res://scripts/core/input_setup.gd"
Router="*res://scripts/core/router.gd"
Audio="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false

[internationalization]

locale/fallback="en"

[shader_globals]

world_gamma={
"type": "float",
"value": 1.0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
